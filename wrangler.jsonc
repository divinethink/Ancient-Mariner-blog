{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  // custom entry: OpenNext fetch + scheduled (Cron) — P5a-৩
  "main": "worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // অজানা URL → ব্র্যান্ডেড 404.html (status 404); না থাকলে আগের আচরণ
    "not_found_handling": "404-page",
    // শুধু এই রুটে Worker চলে; বাকি সব static asset (Worker না চালিয়ে)
    "run_worker_first": ["/dashboard", "/dashboard/*", "/login", "/api/*", "/share/*"]
  },
  // runtime-এ middleware/auth route-এর জন্য (secret নয়); OWNER_UID ও SESSION_SECRET Secret হিসেবে dashboard-এ
  "vars": {
    "FIREBASE_PROJECT_ID": "ancientmarinerblog",
    "SITE_URL": "https://blog.ancientmariner.workers.dev",
    "GITHUB_REPO": "divinethink/Ancient-Mariner-blog",
    // Cloudinary (P6-২): নাম ও API key গোপন নয়; CLOUDINARY_API_SECRET শুধু Worker secret
    "CLOUDINARY_CLOUD_NAME": "vou6klwt",
    "CLOUDINARY_API_KEY": "255854631651555"
  },
  // Cron (UTC): প্রতি ১৫ মিনিটে (P11c-১ scheduled-publish); trash purge/revision prune/D1 cleanup শুধু ~৬-ঘণ্টা স্লটে (lib/schedule isHeavySlot)। FIREBASE_SERVICE_ACCOUNT Worker secret লাগে; rebuild-এর জন্য GITHUB_TOKEN (বিদ্যমান) 
  // D1 (P11a-১): view-count/dedupe। database_id বাদ — `wrangler deploy` প্রথমবার নিজে তৈরি করে (auto-provision; API token-এ D1 Edit লাগে)।
  // টেবিল = migrations/d1/*.sql, `deploy.yml`-এ `wrangler d1 migrations apply DB --remote`। VIEW_HASH_SALT Worker secret।
  "d1_databases": [{ "binding": "DB", "database_name": "blog-counter", "migrations_dir": "migrations/d1" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}

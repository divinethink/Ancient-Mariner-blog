{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  // custom entry: OpenNext fetch + scheduled (Cron) — P5a-৩
  "main": "worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // অজানা URL → ব্র্যান্ডেড 404.html (status 404); না থাকলে আগের আচরণ
    "not_found_handling": "404-page",
    // শুধু এই রুটে Worker চলে; বাকি সব static asset (Worker না চালিয়ে)
    "run_worker_first": ["/dashboard", "/dashboard/*", "/login", "/api/*"]
  },
  // runtime-এ middleware/auth route-এর জন্য (secret নয়); OWNER_UID ও SESSION_SECRET Secret হিসেবে dashboard-এ
  "vars": {
    "FIREBASE_PROJECT_ID": "ancientmarinerblog",
    "SITE_URL": "https://blog.ancientmariner.workers.dev",
    "GITHUB_REPO": "divinethink/Ancient-Mariner-blog",
    // Cloudinary (P6-২): নাম ও API key গোপন নয়; CLOUDINARY_API_SECRET শুধু Worker secret
    "CLOUDINARY_CLOUD_NAME": "vou6klwt",
    "CLOUDINARY_API_KEY": "255854631651555"
  },
  // Cron (UTC): প্রতি ৬ ঘণ্টায় — revision prune ও ৭ দিনের trash purge (P5a-৩)। FIREBASE_SERVICE_ACCOUNT Worker secret লাগে
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": true }
}

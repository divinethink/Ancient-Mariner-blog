{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // শুধু এই রুটে Worker চলে; বাকি সব static asset (Worker না চালিয়ে)
    "run_worker_first": ["/dashboard", "/dashboard/*", "/login", "/api/*"]
  },
  // runtime-এ middleware/auth route-এর জন্য (secret নয়); OWNER_UID ও SESSION_SECRET Secret হিসেবে dashboard-এ
  "vars": {
    "FIREBASE_PROJECT_ID": "ancientmarinerblog",
    "SITE_URL": "https://blog.ancientmariner.workers.dev"
  },
  "observability": { "enabled": true }
}

{
  "name": "ancient-mariner-blog",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build && node scripts/build-public.mjs",
    "typecheck": "tsc --noEmit",
    "deploy:dry": "wrangler deploy --dry-run",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "tsx scripts/render-rules.ts --test && npx --yes firebase-tools@15.32.1 emulators:exec --only firestore --project demo-ancientmarinerblog \"vitest run --config vitest.rules.config.ts\"",
    "format": "prettier --write .",
    "deploy:rules": "tsx scripts/render-rules.ts && npx --yes firebase-tools@15.32.1 deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@fontsource/noto-serif-bengali": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "firebase": "12.19.0",
    "jose": "6.2.12",
    "next": "16.3.8",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.2",
    "@opennextjs/cloudflare": "1.20.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}

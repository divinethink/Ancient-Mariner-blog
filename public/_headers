/*
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://res.cloudinary.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.follow.it; frame-ancestors 'none'

# অ্যাপ-পাতায় (middleware.ts-এর nonce-CSP আছে) পাবলিক CSP বাদ — নইলে দুই CSP-এর intersection-এ Firebase/Firestore ব্লক হয়
/dashboard
  ! Content-Security-Policy

/dashboard/*
  ! Content-Security-Policy

/login
  ! Content-Security-Policy

/share/*
  ! Content-Security-Policy

/build.json
  Cache-Control: no-store

/search-index.json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/sw-policy.js
  Cache-Control: no-cache
